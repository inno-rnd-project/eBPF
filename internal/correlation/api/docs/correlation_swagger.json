        "netobs_internal_correlation.NoisyNeighbor": {
            "type": "object",
            "properties": {
                "dimension": {
                    "$ref": "#/definitions/netobs_internal_correlation.ResourceDimension"
                },
                "granger_ok": {
                    "type": "boolean"
                },
                "impact_ok": {
                    "type": "boolean"
                },
                "impact_seconds": {
                    "description": "#146 effect size 결과. Impact 는 suspect 압박 시 victim latency 증가량 (seconds) 으로 간섭의\n절대 영향 크기다. Score (상관 강도) 와 독립된 지표라 운영자가 우선순위 판단에 함께 활용한다.\nImpactOK=false 면 표본 부족 등으로 산정이 skip 되어 Impact 는 0 이다.",
                    "type": "number"
                },
                "lag_steps": {
                    "type": "integer"
                },
                "p_value": {
                    "description": "#69 Granger causality 결과. PValue 는 src 가 dst 를 Granger-cause 하는지의 통계적 유의성.\nGrangerOK=false 면 표본 부족 또는 행렬 singular 로 산정이 자연 skip 되었다.",
                    "type": "number"
                },
                "rank": {
                    "description": "Rank 는 (victim, victim_signal, dimension) 그룹 내 max_abs_value 내림차순 1-based 순위다. 1 이 가장 강한 상관.",
                    "type": "integer"
                },
                "sample_count": {
                    "type": "integer"
                },
                "score": {
                    "type": "number"
                },
                "suspect": {
                    "$ref": "#/definitions/netobs_internal_correlation.PodIdentity"
                },
                "suspect_metric": {
                    "type": "string"
                },
                "victim": {
                    "$ref": "#/definitions/netobs_internal_correlation.PodIdentity"
                },
                "victim_metric": {
                    "type": "string"
                },
                "victim_signal": {
                    "description": "VictimSignal 은 #150 의 victim 영향 종착 차원 (latency / throughput / error) 이다. dimension 이\nsuspect 의 자원 종류라면 VictimSignal 은 victim 측 품질 저하의 종류다. Top-N 은 (victim, victim_\nsignal, dimension) 그룹별로 산정되어 한 victim 이 신호별로 독립 순위를 갖는다.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/netobs_internal_correlation.VictimSignal"
                        }
                    ]
                }
            }
        },
