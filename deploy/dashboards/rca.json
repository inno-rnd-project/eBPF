{
  "title": "rca-summarizer",
  "uid": "rca-summarizer",
  "tags": ["observability", "rca", "alertmanager"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Recent RCA summaries",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Latest RCA summary per alert (alert당 1 시리즈)",
      "datasource": "${datasource}",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "custom": { "align": "left" } } },
      "targets": [
        {
          "expr": "max by(alert_name, dominant_dimension, top_suspect, primary_drop_flow) (rca_summary_last_summary_info)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "endpoint": true, "service": true, "namespace": true, "container": true, "pod": true } } }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Webhook activity",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RCA emit rate by alert (events/s)",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "sum by (alert_name) (rate(rca_summary_emitted_total[5m]))",
          "legendFormat": "{{alert_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "rca-summarizer up",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }] } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "max by(job) (up{job=\"rca-summarizer\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Cumulative emit",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total RCA summaries emitted per alert (since restart)",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "max by(alert_name) (rca_summary_emitted_total)",
          "legendFormat": "{{alert_name}}",
          "refId": "A"
        }
      ]
    }
  ]
}
