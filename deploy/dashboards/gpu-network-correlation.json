{
  "title": "GPU x network cross-correlation",
  "uid": "gpu-network-correlation",
  "tags": [
    "correlation",
    "gpuobs",
    "netobs",
    "cross-domain"
  ],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(gpuobs_device_utilization_percent, node)",
        "multi": false,
        "includeAll": false,
        "label": "Node",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "src_namespace",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(netobs_pod_bytes_total{node=\"$node\"}, src_namespace)",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "label": "Pod namespace",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "src_pod",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(netobs_pod_bytes_total{node=\"$node\",src_namespace=~\"$src_namespace\"}, src_pod)",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "label": "Pod",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "gpu_uuid",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(gpuobs_device_utilization_percent{node=\"$node\"}, gpu_uuid)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "label": "GPU UUID",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU x network cross-correlation ($node, $src_namespace/$src_pod)",
      "description": "GPU device 시계열 (node, gpu_uuid scope) 과 network Pod 시계열 (node, src_namespace, src_pod scope) 을 같은 timeline 에 정렬한다. dev cluster spike 결과 RTX 3090 NVML 이 Pod scope GPU utilization 을 노출하지 않아 GPU 도메인은 device scope 로 강등 적용되었다. 두 도메인의 Pod 인스턴스 단위 정합은 본 패널 범위 밖이며 같은 timeline 위에서 GPU 유휴와 network pressure 의 상관 관계를 시각적으로 비교하는 것이 의도다. overlay 의 correlation_noisy_neighbor_score 는 victim_pod=$src_pod 매칭으로 GPU / network dimension 의 noisy neighbor 신호를 보조 시리즈로 보여준다.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": null
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": null
              }
            ]
          }
        ]
      },
      "links": [
        {
          "title": "Drill into gpuobs overview",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-node=${node:regex}&var-src_namespace=${src_namespace:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?var-victim_namespace=${src_namespace:regex}&var-victim_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "avg by(node) (node:gpu_util_ratio:5m{node=\"$node\"})",
          "legendFormat": "GPU util (node={{node}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "B",
          "expr": "avg by(node) (node:gpu_memory_used_ratio:5m{node=\"$node\"})",
          "legendFormat": "GPU mem used (node={{node}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "C",
          "expr": "sum by(node, src_namespace, src_pod) (pod:network_throughput_bps:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "legendFormat": "network throughput ({{src_namespace}}/{{src_pod}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "D",
          "expr": "max by(node, src_namespace, src_pod) (pod:network_p99_latency_seconds:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "legendFormat": "network p99 latency ({{src_namespace}}/{{src_pod}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "E",
          "expr": "max by(victim_namespace, victim_pod, resource_dimension) (correlation_noisy_neighbor_score{victim_namespace=~\"$src_namespace\",victim_pod=~\"$src_pod\",resource_dimension=~\"gpu|network\"})",
          "legendFormat": "noisy neighbor score ({{victim_namespace}}/{{victim_pod}} dim={{resource_dimension}})",
          "datasource": "${datasource}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU idle cause weight per victim ($src_namespace/$src_pod)",
      "description": "#101 victim 단위 GPU idle 6 cause 가중치 분포. pod:gpu_idle_cause_weight:5m 의 6 cause (pcie_saturation, cpu_throttle, memory_pressure, network_pressure, host_compute_stall, cgroup_contention) 를 victim 별 stacked time-series 로 표시한다. 주의: victim 체인은 절대 압박 score 기반이라 #244 의 rise 기반 cluster dominant 와 산정 기반이 다르다. 상시 포화 pod 가 여기 에는 남고 cluster dominant 에는 없는 것은 버그가 아니라 설계다. stacked 높이 합이 1.0 에 가까우면 idle 게이팅 활성 시간대이며 비어 있으면 GPU 가 idle 이 아니거나 cause 합이 0 인 상태다.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*pcie_saturation.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*cpu_throttle.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*memory_pressure.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*network_pressure.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*host_compute_stall.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "links": [
        {
          "title": "Dominant cause 운영 가이드",
          "url": "https://github.com/inno-rnd-project/eBPF/blob/main/docs/observability/gpu-idle-dominant-cause.md",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "pod:gpu_idle_cause_weight:5m{node=\"$node\",victim_namespace=~\"$src_namespace\",victim_pod=~\"$src_pod\"}",
          "legendFormat": "{{cause}} ({{victim_namespace}}/{{victim_pod}})",
          "datasource": "${datasource}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dominant cause indicator timeline ($src_namespace/$src_pod)",
      "description": "#101 victim 단위 dominant cause indicator 시계열. victim:gpu_idle_dominant_cause_indicator:5m 가 cause 별 0/1 로 emit 되어 1 인 cause 가 해당 시점의 dominant 다. 시간축 상 dominant cause 가 swap 되는 시점이 운영자에게 cause flapping (GPUIdleDominantCauseSwitch alert) 또는 ambiguous (GPUIdleDominantCauseAmbiguous alert) 신호로 보인다. stepBefore 라인으로 cause indicator 의 discrete state 전이를 시각화한다.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1.1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "stepBefore"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "victim:gpu_idle_dominant_cause_indicator:5m{node=\"$node\",victim_namespace=~\"$src_namespace\",victim_pod=~\"$src_pod\"}",
          "legendFormat": "{{cause}} ({{victim_namespace}}/{{victim_pod}})",
          "datasource": "${datasource}"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Pod 단위 multi-domain 분석 (#120)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod 단위 GPU x network dual-axis ($src_namespace/$src_pod)",
      "description": "#120 Pod 단위 multi-domain 분석. pod:gpu_util_p95:5m 와 pod:network_throughput_bps:5m 와 pod:network_p99_latency_seconds:5m 를 동일 4 Pod 라벨 join key (node, src_namespace, src_pod, src_pod_uid) 로 한 차트 에 시간 정렬 한다. 좌축 GPU util percentunit, 우축 network throughput bps 와 network p99 latency seconds.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": null
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": null
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(node, src_namespace, src_pod) (pod:gpu_util_p95:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\",gpu_uuid=~\"$gpu_uuid\"}) / 100",
          "legendFormat": "GPU util p95 ({{src_namespace}}/{{src_pod}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "B",
          "expr": "sum by(node, src_namespace, src_pod) (pod:network_throughput_bps:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "legendFormat": "network throughput ({{src_namespace}}/{{src_pod}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "C",
          "expr": "max by(node, src_namespace, src_pod) (pod:network_p99_latency_seconds:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "legendFormat": "network p99 latency ({{src_namespace}}/{{src_pod}})",
          "datasource": "${datasource}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top cross-domain Pod (pod:gpu_network_correlation_score:5m)",
      "description": "#120 의 신규 score TopN 표. GPU 사용률 정규화 와 network 대역폭 점유율 의 곱 형태 단일 score 가 높은 상위 20 Pod 를 노출 한다. score 0 인 Pod 는 GPU factor 또는 network factor 한쪽 이 0 인 상태 라 join score 도 0 이 다.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, pod:gpu_network_correlation_score:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "instant": true,
          "format": "table",
          "datasource": "${datasource}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "container": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "src_pod_uid": true
            },
            "renameByName": {
              "Value": "score",
              "node": "node",
              "src_namespace": "namespace",
              "src_pod": "pod"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "score",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "score"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 4
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.1
                    },
                    {
                      "color": "orange",
                      "value": 0.3
                    },
                    {
                      "color": "red",
                      "value": 0.5
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "links": [
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-src_namespace=${__data.fields.namespace}&var-src_pod=${__data.fields.pod}&${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 7,
      "type": "xychart",
      "title": "Pod 별 GPU util x network throughput 산점",
      "description": "#120 Pod 단위 GPU 와 network 두 도메인 의 동조 분포 산점도. x 축 GPU util p95 percentunit, y 축 network throughput bps. 우상단 영역 의 Pod 가 GPU heavy + network heavy 동시 만족.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "options": {
        "mapping": "auto",
        "series": [
          {
            "frame": {
              "matcher": {
                "id": "byName",
                "options": "scatter"
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "gpu_util"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "network_throughput"
              }
            }
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(src_namespace, src_pod) (pod:gpu_util_p95:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\",gpu_uuid=~\"$gpu_uuid\"}) / 100",
          "instant": true,
          "format": "table",
          "legendFormat": "gpu_util",
          "datasource": "${datasource}"
        },
        {
          "refId": "B",
          "expr": "sum by(src_namespace, src_pod) (pod:network_throughput_bps:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "instant": true,
          "format": "table",
          "legendFormat": "network_throughput",
          "datasource": "${datasource}"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "gpu_util",
              "Value #B": "network_throughput"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "axisCenteredZero": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "lineWidth": 0,
            "fillOpacity": 50,
            "pointSize": 5
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Node dominant cause ($node)",
      "description": "node:gpu_idle_dominant_cause:5m{node=\"$node\"} (#256). 노드 단위 GPU 유휴 dominant cause 로, cluster (rise 기반) 와 victim (절대 기반) 사이의 노드 scope 계층이다. gpu-rca API 의 dominant_cause 와 동일 시리즈이며, cause 라벨별 시리즈로 시간축 상 dominant 전이를 본다.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineInterpolation": "stepBefore"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node:gpu_idle_dominant_cause:5m{node=\"$node\"}",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "alerts-critical",
        "datasource": "${datasource}",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\",severity=\"critical\",component=~\"netobs|gpuobs|netobs-capacity|gpuobs-capacity|netobs-anomaly|gpuobs-anomaly\"}",
        "tagKeys": "severity,component,alertname",
        "titleFormat": "{{alertname}}",
