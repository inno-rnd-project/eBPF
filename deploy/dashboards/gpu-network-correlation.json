{
  "title": "GPU x network cross-correlation",
  "uid": "gpu-network-correlation",
  "tags": [
    "correlation",
    "gpuobs",
    "netobs",
    "cross-domain"
  ],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(gpuobs_device_utilization_percent, node)",
        "multi": false,
        "includeAll": false,
        "label": "Node",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "src_namespace",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(netobs_pod_bytes_total{node=\"$node\"}, src_namespace)",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "label": "Pod namespace",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "src_pod",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(netobs_pod_bytes_total{node=\"$node\",src_namespace=~\"$src_namespace\"}, src_pod)",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "label": "Pod",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU x network cross-correlation ($node, $src_namespace/$src_pod)",
      "description": "GPU device 시계열 (node, gpu_uuid scope) 과 network Pod 시계열 (node, src_namespace, src_pod scope) 을 같은 timeline 에 정렬한다. dev cluster spike 결과 RTX 3090 NVML 이 Pod scope GPU utilization 을 노출하지 않아 GPU 도메인은 device scope 로 강등 적용되었다. 두 도메인의 Pod 인스턴스 단위 정합은 본 패널 범위 밖이며 같은 timeline 위에서 GPU 유휴와 network pressure 의 상관 관계를 시각적으로 비교하는 것이 의도다. overlay 의 correlation_noisy_neighbor_score 는 victim_pod=$src_pod 매칭으로 GPU / network dimension 의 noisy neighbor 신호를 보조 시리즈로 보여준다.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": null
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": null
              }
            ]
          }
        ]
      },
      "links": [
        {
          "title": "Drill into gpuobs overview",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-node=${node:regex}&var-src_namespace=${src_namespace:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?var-victim_namespace=${src_namespace:regex}&var-victim_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "avg by(node) (node:gpu_util_ratio:5m{node=\"$node\"})",
          "legendFormat": "GPU util (node={{node}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "B",
          "expr": "avg by(node) (node:gpu_memory_used_ratio:5m{node=\"$node\"})",
          "legendFormat": "GPU mem used (node={{node}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "C",
          "expr": "sum by(node, src_namespace, src_pod) (pod:network_throughput_bps:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "legendFormat": "network throughput ({{src_namespace}}/{{src_pod}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "D",
          "expr": "max by(node, src_namespace, src_pod) (pod:network_p99_latency_seconds:5m{node=\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"})",
          "legendFormat": "network p99 latency ({{src_namespace}}/{{src_pod}})",
          "datasource": "${datasource}"
        },
        {
          "refId": "E",
          "expr": "max by(victim_namespace, victim_pod, resource_dimension) (correlation_noisy_neighbor_score{victim_namespace=~\"$src_namespace\",victim_pod=~\"$src_pod\",resource_dimension=~\"gpu|network\"})",
          "legendFormat": "noisy neighbor score ({{victim_namespace}}/{{victim_pod}} dim={{resource_dimension}})",
          "datasource": "${datasource}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU idle cause weight per victim ($src_namespace/$src_pod)",
      "description": "#101 victim 단위 GPU idle 5 cause 가중치 분포. pod:gpu_idle_cause_weight:5m 5 cause (pcie_saturation 와 cpu_throttle 와 memory_pressure 와 network_pressure 와 host_compute_stall) 를 victim 별 stacked time-series 로 표시한다. 각 cause 는 고정 색상으로 운영자가 secondary 와 tertiary cause 까지 한눈에 비교 가능하다. 시리즈 의 stacked 높이 합이 1.0 에 가까우면 idle 게이팅 활성 시간대 이며 비어 있으면 GPU 가 idle 이 아니거나 cause 합이 0 인 상태다. dimension 4 종 과 cause 5 종 매핑 은 docs/observability/gpu-idle-dominant-cause.md 의 매핑 표 참조.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*pcie_saturation.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*cpu_throttle.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*memory_pressure.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*network_pressure.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*host_compute_stall.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "links": [
        {
          "title": "Dominant cause 운영 가이드",
          "url": "https://github.com/inno-rnd-project/netobs/blob/main/docs/observability/gpu-idle-dominant-cause.md",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "pod:gpu_idle_cause_weight:5m{victim_namespace=~\"$src_namespace\",victim_pod=~\"$src_pod\"}",
          "legendFormat": "{{cause}} ({{victim_namespace}}/{{victim_pod}})",
          "datasource": "${datasource}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dominant cause indicator timeline ($src_namespace/$src_pod)",
      "description": "#101 victim 단위 dominant cause indicator 시계열. victim:gpu_idle_dominant_cause_indicator:5m 가 cause 별 0/1 로 emit 되어 1 인 cause 가 해당 시점의 dominant 다. 시간축 상 dominant cause 가 swap 되는 시점이 운영자에게 cause flapping (GPUIdleDominantCauseSwitch alert) 또는 ambiguous (GPUIdleDominantCauseAmbiguous alert) 신호로 보인다. stepBefore 라인으로 cause indicator 의 discrete state 전이를 시각화한다.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1.1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "stepBefore"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "victim:gpu_idle_dominant_cause_indicator:5m{victim_namespace=~\"$src_namespace\",victim_pod=~\"$src_pod\"}",
          "legendFormat": "{{cause}} ({{victim_namespace}}/{{victim_pod}})",
          "datasource": "${datasource}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "alerts-critical",
        "datasource": "${datasource}",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\",severity=\"critical\",component=~\"netobs|gpuobs|netobs-capacity|gpuobs-capacity|netobs-anomaly|gpuobs-anomaly\"}",
        "tagKeys": "severity,component,alertname",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}} component={{component}}"
      },
      {
        "name": "alerts-warning",
        "datasource": "${datasource}",
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "ALERTS{alertstate=\"firing\",severity=\"warning\",component=~\"netobs|gpuobs|netobs-capacity|gpuobs-capacity|netobs-anomaly|gpuobs-anomaly\"}",
        "tagKeys": "severity,component,alertname",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}} component={{component}}"
      }
    ]
  }
}
