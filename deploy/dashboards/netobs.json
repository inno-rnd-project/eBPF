{
  "title": "netobs",
  "uid": "netobs-overview",
  "tags": [
    "netobs",
    "ebpf"
  ],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(netobs_stage_latency_labeled_seconds_count, node)",
        "multi": true,
        "includeAll": true,
        "label": "Node",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "src_namespace",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(netobs_stage_latency_labeled_seconds_count{node=~\"$node\"}, src_namespace)",
        "multi": true,
        "includeAll": true,
        "label": "Source namespace",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "src_pod",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(netobs_pod_stage_latency_labeled_seconds_count{node=~\"$node\",src_namespace=~\"$src_namespace\"}, src_pod)",
        "description": "netobs-agent\uc758 Pod metrics\uac00 \ube44\ud65c\uc131(POD_METRICS_ENABLED=false)\uc778 \ud658\uacbd\uc5d0\uc11c\ub294 \ubcf8 \ubcc0\uc218\uac00 \ube44\uac8c \ub41c\ub2e4. \uadf8 \uacbd\uc6b0 'Per-pod stage latency p95' \ud328\ub110\ub9cc \uc601\ud5a5\uc744 \ubc1b\uace0 stage / drop / retransmission \ud328\ub110\uc740 \uc815\uc0c1 \ub3d9\uc791\ud55c\ub2e4.",
        "multi": true,
        "includeAll": true,
        "label": "Source pod",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Send path stage latency p99 (sendmsg_ret / tcp_write_xmit / tcp_transmit_skb / to_devq)",
      "description": "#82 send path 4 stage \ubd84\ud574. tcp_sendmsg syscall \uc9c4\uc785\ubd80\ud130 __dev_queue_xmit NIC queue \uc9c4\uc785\uae4c\uc9c0\uc758 kernel \ub0b4\ubd80 \ucc98\ub9ac \uc2dc\uac04\uc744 stage \ub2e8\uc704\ub85c \ub178\ucd9c\ud55c\ub2e4. tcp_write_xmit \ub294 TCP control path (cwnd / nagle / window throttle), tcp_transmit_skb \ub294 \uac1c\ubcc4 segment transmit entry \uc758 latency \ub2e4 (TSO/GSO \ud65c\uc131 \uc2dc \uccab segment \ub9cc \uce21\uc815).",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, stage, node) (rate(netobs_stage_latency_labeled_seconds_bucket{node=~\"$node\",src_namespace=~\"$src_namespace\",stage=~\"sendmsg_ret|tcp_write_xmit|tcp_transmit_skb|to_devq\"}[5m])))",
          "legendFormat": "{{stage}} ({{node}})",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into gpuobs overview",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Receive path stage latency p99 (rcv_demux / rcv_established / rcv_app)",
      "description": "#65 receive path 3 stage. tcp_v4_do_rcv socket lookup \uc9c1\ud6c4\ubd80\ud130 tcp_recvmsg app boundary \uae4c\uc9c0\uc758 \ucc98\ub9ac \uc2dc\uac04\uc744 stage \ub2e8\uc704\ub85c \ub178\ucd9c\ud55c\ub2e4. send path \ud328\ub110\uacfc \uac19\uc740 \ud654\uba74 \ube44\uad50\ub85c \uc591\ubc29\ud5a5 stage breakdown \uc744 \ud55c \ub208\uc5d0 \ubcf8\ub2e4.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, stage, node) (rate(netobs_stage_latency_labeled_seconds_bucket{node=~\"$node\",src_namespace=~\"$src_namespace\",stage=~\"rcv_demux|rcv_established|rcv_app\"}[5m])))",
          "legendFormat": "{{stage}} ({{node}})",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into gpuobs overview",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Drop rate by category (events/s)",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by (drop_category) (rate(netobs_drop_events_labeled_total{node=~\"$node\",src_namespace=~\"$src_namespace\"}[5m]))",
          "legendFormat": "{{drop_category}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into gpuobs overview",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Open RCA summarizer",
          "url": "/d/rca-summarizer?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top drop reasons by workload (5m rate)",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "drop_reason": 1,
              "drop_category": 2,
              "src_namespace": 3,
              "src_workload": 4,
              "node": 5,
              "Value": 6
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(20, sum by (drop_reason, drop_category, src_namespace, src_workload, node) (rate(netobs_drop_events_labeled_total{node=~\"$node\",src_namespace=~\"$src_namespace\"}[5m])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into gpuobs overview",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Open RCA summarizer",
          "url": "/d/rca-summarizer?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TCP retransmission rate by workload (events/s)",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by (node, src_namespace, src_workload) (rate(netobs_retrans_events_labeled_total{node=~\"$node\",src_namespace=~\"$src_namespace\"}[5m]))",
          "legendFormat": "{{src_namespace}}/{{src_workload}} ({{node}})",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into gpuobs overview",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-pod stage latency p95 (filtered by src_pod)",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage, src_pod, src_namespace) (rate(netobs_pod_stage_latency_labeled_seconds_bucket{node=~\"$node\",src_namespace=~\"$src_namespace\",src_pod=~\"$src_pod\"}[5m])))",
          "legendFormat": "{{src_namespace}}/{{src_pod}} {{stage}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Drill into gpuobs per-pod",
          "url": "/d/gpuobs-overview?var-node=${node:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation (victim)",
          "url": "/d/correlation-overview?var-victim_namespace=${src_namespace:regex}&var-victim_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Agent self-health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "BPF program attach status",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "missing",
                  "color": "red"
                },
                "1": {
                  "text": "attached",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max by(symbol) (netobs_bpf_program_loaded)",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "BPF ringbuf drop rate",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by(job) (rate(netobs_bpf_ringbuf_drops_total[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "BPF map utilization",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max by(job, map) (netobs_bpf_map_utilization_ratio)",
          "legendFormat": "{{job}} {{map}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Informer sync lag",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max by(job) (netobs_informer_sync_lag_seconds)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Agent up",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max by(job) (up{job=\"netobs-agent\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 200,
      "type": "timeseries",
      "title": "Network flow bytes by ip_version (IPv4/IPv6 stacked, requires NETOBS_FLOW_ALLOW_NAMESPACES)",
      "description": "#103 IPv6/UDP \ud2b8\ub798\ud53d \ucd94\uc801 \ud655\uc7a5. netobs_flow_bytes_total \uc758 ip_version \ub77c\ubca8\ub85c IPv4/IPv6 \ubd84\ud3ec\ub97c stacked time-series\ub85c \ub178\ucd9c\ud55c\ub2e4. flow_bytes\ub294 NETOBS_FLOW_ALLOW_NAMESPACES \ud658\uacbd \ubcc0\uc218\uac00 \uc124\uc815\ub41c namespace \uc758 5-tuple flow \ub9cc emit \ud55c\ub2e4. ip_version=4 (IPv4) blue, ip_version=6 (IPv6) red \uc0c9\uc0c1\uc73c\ub85c \ud55c\ub208\uc5d0 \ubd84\ud3ec \ube44\uad50 \uac00\ub2a5.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ip_version) (rate(netobs_flow_bytes_total{node=~\"$node\",src_namespace=~\"$src_namespace\"}[5m]))",
          "legendFormat": "ip_version={{ip_version}}",
          "datasource": "${datasource}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ip_version=4.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ip_version=6.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "Drop events by ip_version (5m rate)",
      "description": "#103 netobs_drop_events_flow_total \uc758 ip_version \ub77c\ubca8\ub85c IPv4/IPv6 drop event \ubd84\ud3ec \ub178\ucd9c. flow_total \uc740 NETOBS_DROP_FLOW_ALLOW_NAMESPACES \ud658\uacbd \ubcc0\uc218 \uac00 \uc124\uc815 \ub41c namespace \ub9cc emit.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ip_version, drop_category) (rate(netobs_drop_events_flow_total{node=~\"$node\",src_namespace=~\"$src_namespace\"}[5m]))",
          "legendFormat": "ip_version={{ip_version}} category={{drop_category}}",
          "datasource": "${datasource}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 110,
      "type": "timeseries",
      "title": "BPF program attach result rate (#105)",
      "datasource": "${datasource}",
      "description": "BPF program attach \uc2dc\ub3c4\uc758 result \ubcc4 \ub204\uc801 \uce74\uc6b4\ud130 rate. result=success \uac00 \uc815\uc0c1 \ud658\uacbd\uc758 \uae30\ubcf8 \uc2e0\ud638, result=failure \uac00 \uc601\uad6c \uc2e4\ud328 \ub610\ub294 transient flap \uc758 spike \uc2e0\ud638. netobs_bpf_program_loaded gauge \uc640 \ud568\uaed8 \ubcf4\uba74 \ud604\uc7ac \uc0c1\ud0dc (gauge) vs \uc2dc\ub3c4 \ube48\ub3c4 (counter rate) \uc758 \uc758\ubbf8 \ubd84\ub9ac\uac00 \uc989\uc2dc \ubcf4\uc778\ub2e4.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 66
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by(program, result) (rate(netobs_bpf_program_attach_total[5m]))",
          "legendFormat": "{{program}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "BPF attach retry pressure by reason (#105)",
      "datasource": "${datasource}",
      "description": "attach \uc2e4\ud328 reason \ubcc4 retry \uce74\uc6b4\ud130 rate. 7\uc885 enum (symbol_not_found / kernel_version_mismatch / btf_missing / verifier_rejected / permission_denied / link_internal_error / other) \uc73c\ub85c \ubd84\ub958 \ub41c retry \ubd80\ub2f4 \ucd94\uc138. \ud2b9\uc815 reason \uc758 spike \uac00 root cause \uc9c4\ub2e8\uc758 1\ucc28 \ub2e8\uc11c.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 66
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by(program, reason) (rate(netobs_bpf_program_attach_retry_total[5m]))",
          "legendFormat": "{{program}} {{reason}}",
          "refId": "A"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "alerts-critical",
