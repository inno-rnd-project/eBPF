{
  "title": "gpuobs",
  "uid": "gpuobs-overview",
  "tags": [
    "gpuobs",
    "ebpf",
    "nvml"
  ],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(gpuobs_device_utilization_percent, node)",
        "multi": true,
        "includeAll": true,
        "label": "Node",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "gpu_uuid",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(gpuobs_device_utilization_percent{node=~\"$node\"}, gpu_uuid)",
        "multi": true,
        "includeAll": true,
        "label": "GPU UUID",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "src_pod",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(gpuobs_pod_memory_used_bytes{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"}, src_pod)",
        "multi": true,
        "includeAll": true,
        "label": "Pod (GPU \uc6cc\ud06c\ub85c\ub4dc)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU utilization %",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_utilization_percent{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "{{node}} gpu{{gpu_index}} ({{gpu_model}})",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU memory used / total",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_memory_used_bytes{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "used {{node}} gpu{{gpu_index}}",
          "refId": "A"
        },
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_memory_total_bytes{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "total {{node}} gpu{{gpu_index}}",
          "refId": "B"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature (current vs threshold)",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_temperature_celsius{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "current {{node}} gpu{{gpu_index}}",
          "refId": "A"
        },
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model, threshold) (gpuobs_device_temperature_threshold_celsius{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "{{threshold}} {{node}} gpu{{gpu_index}}",
          "refId": "B"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Power usage vs limit (W)",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_power_usage_watts{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "usage {{node}} gpu{{gpu_index}}",
          "refId": "A"
        },
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_power_limit_watts{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "limit {{node}} gpu{{gpu_index}}",
          "refId": "B"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Throttle active reasons",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "node": 0,
              "gpu_index": 1,
              "reason": 2,
              "Value": 3
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model, reason) (gpuobs_device_throttle_active{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"}) == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Back to observability overview",
          "url": "/d/observability-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into netobs overview",
          "url": "/d/netobs-overview?var-node=${node:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation overview",
          "url": "/d/correlation-overview?${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-pod GPU memory used",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(node, src_namespace, src_pod, src_pod_uid, gpu_uuid, gpu_index) (gpuobs_pod_memory_used_bytes{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",src_pod=~\"$src_pod\"})",
          "legendFormat": "{{src_namespace}}/{{src_pod}} gpu{{gpu_index}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Drill into netobs per-pod",
          "url": "/d/netobs-overview?var-node=${node:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation (victim)",
          "url": "/d/correlation-overview?var-victim_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CUDA kernel launch rate by pod",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by (src_namespace, src_pod, gpu_uuid) (rate(gpuobs_cuda_kernel_launches_total{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",src_pod=~\"$src_pod\"}[5m]))",
          "legendFormat": "{{src_namespace}}/{{src_pod}} {{gpu_uuid}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Drill into netobs per-pod",
          "url": "/d/netobs-overview?var-node=${node:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation (victim)",
          "url": "/d/correlation-overview?var-victim_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CUDA H2D / D2H transfer bytes/s by pod",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by (src_namespace, src_pod, gpu_uuid) (rate(gpuobs_cuda_h2d_bytes_total{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",src_pod=~\"$src_pod\"}[5m]))",
          "legendFormat": "H2D {{src_namespace}}/{{src_pod}} {{gpu_uuid}}",
          "refId": "A"
        },
        {
          "expr": "sum by (src_namespace, src_pod, gpu_uuid) (rate(gpuobs_cuda_d2h_bytes_total{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",src_pod=~\"$src_pod\"}[5m]))",
          "legendFormat": "D2H {{src_namespace}}/{{src_pod}} {{gpu_uuid}}",
          "refId": "B"
        }
      ],
      "links": [
        {
          "title": "Drill into netobs per-pod",
          "url": "/d/netobs-overview?var-node=${node:regex}&var-src_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        },
        {
          "title": "Drill into correlation (victim)",
          "url": "/d/correlation-overview?var-victim_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Thermal x power cross-reference (#68)",
      "description": "RTX consumer GPU \uc758 thermal \uacfc power \uc2dc\uacc4\uc5f4\uc744 dual axis \ub85c \ub3d9\uc77c timeline \uc5d0 \ud45c\uc2dc\ud55c\ub2e4. \uc88c\uce21 \ucd95\uc740 temperature (\u2103) \ub85c hw_thermal_slowdown threshold \uc640 \ube44\uad50, \uc6b0\uce21 \ucd95\uc740 power usage (W) \ub85c power limit \uacfc \ube44\uad50\ud55c\ub2e4.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*temperature.*|.*temp.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*power.*|.*watts.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_temperature_celsius{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "temperature {{node}} gpu{{gpu_index}}",
          "refId": "A"
        },
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model) (gpuobs_device_power_usage_watts{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "power {{node}} gpu{{gpu_index}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Clock and thermal throttle cross-reference (#68)",
      "description": "graphics clock \uc758 boost / drop \ucd94\uc138 (\uc88c\uce21 \ucd95 MHz) \uc640 hw_thermal_slowdown throttle \uc758 \ud65c\uc131 \uc2dc\uc810 (\uc6b0\uce21 \ucd95 0-1) \uc744 \uac19\uc740 timeline \uc5d0 \ud45c\uc2dc\ud55c\ub2e4. clock \uc774 \ud558\ud5a5 \uc870\uc815\ub418\ub294 \uad6c\uac04\uc5d0\uc11c throttle \uc774 1 \ub85c \uc62c\ub77c\uc624\uba74 thermal \uc601\ud5a5\uc774 \uac15\ud55c \uc2e0\ud638\ub2e4.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*clock.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisLabel",
                "value": "MHz"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*throttle.*|.*hw_thermal.*|.*slowdown.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisLabel",
                "value": "throttle 0/1"
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model, clock) (gpuobs_device_clock_mhz{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",clock=\"graphics\"})",
          "legendFormat": "graphics clock {{node}} gpu{{gpu_index}}",
          "refId": "A"
        },
        {
          "expr": "max by(node, gpu_uuid, gpu_index, gpu_model, reason) (gpuobs_device_throttle_active{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",reason=\"hw_thermal_slowdown\"})",
          "legendFormat": "hw_thermal_slowdown {{node}} gpu{{gpu_index}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Agent self-health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "CUDA symbol attach status",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "missing",
                  "color": "red"
                },
                "1": {
                  "text": "attached",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max by(node, symbol) (gpuobs_cuda_symbol_available)",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "NVML call duration p99",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(le, node, call) (rate(gpuobs_nvml_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{call}} p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "NVML error rate",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by(node, call, error_code) (rate(gpuobs_nvml_errors_total[5m]))",
          "legendFormat": "{{call}} {{error_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Informer sync lag",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max by(job) (gpuobs_informer_sync_lag_seconds)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Agent up",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max by(job) (up{job=\"gpuobs-agent\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 200,
      "type": "timeseries",
      "title": "Per-pod GPU utilization % (#104)",
      "datasource": "${datasource}",
      "description": "Pod-level GPU compute utilization (gpuobs_pod_utilization_percent) introduced in #104. Best-effort while gpuobs_cuda_pid_multi_gpu_count is nonzero. Check gpuobs_mps_active stat panel for MPS-induced inaccuracy",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 65
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(src_namespace, src_pod, gpu_uuid) (gpuobs_pod_utilization_percent{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",src_pod=~\"$src_pod\"})",
          "legendFormat": "{{src_namespace}}/{{src_pod}} {{gpu_uuid}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Drill into correlation (victim)",
          "url": "/d/correlation-overview?var-victim_pod=${src_pod:regex}&${__url_time_range}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "MIG instance Pod utilization % (#104)",
      "datasource": "${datasource}",
      "description": "MIG instance level Pod GPU utilization (gpuobs_pod_mig_utilization_percent). Emits only when parent device has MIG mode = enabled (A100 / H100 partitioned environments). Empty on RTX 3090 dev cluster \u2014 expected (graceful degradation, mig_mode=unsupported)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 65
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "max by(src_namespace, src_pod, mig_uuid, gi_id) (gpuobs_pod_mig_utilization_percent{node=~\"$node\",src_pod=~\"$src_pod\"})",
          "legendFormat": "{{src_namespace}}/{{src_pod}} mig={{mig_uuid}} gi={{gi_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 202,
      "type": "stat",
      "title": "MIG mode / MPS active (#104 self-health)",
      "datasource": "${datasource}",
      "description": "Self-health stat. MIG mode shows enabled/disabled/unsupported per device. MPS active = 1 means per-process SM util is best-effort (single CUDA context time-sliced across multiple processes)",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 73
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max by(node, gpu_uuid, mode) (gpuobs_mig_mode{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"} == 1)",
          "legendFormat": "MIG {{node}}/{{gpu_uuid}} = {{mode}}",
          "refId": "A"
        },
        {
          "expr": "max by(node, gpu_uuid) (gpuobs_mps_active{node=~\"$node\",gpu_uuid=~\"$gpu_uuid\"})",
          "legendFormat": "MPS active {{node}}/{{gpu_uuid}}",
          "refId": "B"
        }
      ]
    }
  ],
